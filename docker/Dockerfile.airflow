# =============================================================================
# Dockerfile for Airflow - LIGHTWEIGHT version (~500MB)
# NO PyTorch/ML dependencies - calls FastAPI for ML tasks
# =============================================================================
FROM apache/airflow:slim-2.9.3-python3.11

USER root

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

USER airflow

WORKDIR /app

# Install ONLY lightweight dependencies for API calls
# NO torch, torchvision, tensorflow, etc.
RUN pip install --no-cache-dir \
    httpx>=0.27.0 \
    pyyaml>=6.0.3 \
    pydantic>=2.0.0 \
    psycopg2-binary>=2.9.0 \
    apache-airflow-providers-http==4.10.0

# Copy DAGs and minimal config
COPY dags /app/dags
COPY conf.yaml /app/conf.yaml

# Copy only the services needed for DAGs (yaml_loader, etc.)
# NOT the ML services
COPY src/services/yaml_loader.py /app/src/services/yaml_loader.py
COPY src/services/__init__.py /app/src/services/__init__.py
COPY src/__init__.py /app/src/__init__.py
COPY src/core /app/src/core

# Set environment variables
ENV PYTHONPATH=/app
ENV FASTAPI_URL=http://api:8000
